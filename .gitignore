#
# GIT Ignore
#
# * Version: 1.1.0
# * Template: 2.0.1
#

#
# Main
#

/build/*
/lib/*
/logs/*
/tmp/*
/vault/*
/.local.env
/.secrets.env

/.vscode

#
# Project specific exclusions
#

# GO Lang
/vendor

# FluxCD / Upstream only: do not save FluxCD deployment
/var/dev/fluxcd/flux-system/*

# Keep placeholder for empty directories
!/**/.gitkeep
